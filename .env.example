# ===================================
# REQUIRED VARIABLES
# ===================================

# Database - Required for contact form and booking demo
DATABASE_URL=mysql://username:password@host:3306/database

# JWT Secret - Required for session management
# Generate with: openssl rand -base64 32
JWT_SECRET=generate_with_openssl_rand_base64_32

# Application ID - Can be any string
VITE_APP_ID=chapter-one-portfolio

# ===================================
# OPTIONAL - OAuth Authentication
# Only needed for admin dashboard
# ===================================

# OAUTH_SERVER_URL=https://your-oauth-server.com
# VITE_OAUTH_PORTAL_URL=https://your-oauth-portal.com
# OWNER_OPEN_ID=admin_user_openid

# ===================================
# OPTIONAL - Branding
# ===================================

VITE_APP_TITLE=ChapterOne Portfolio
VITE_APP_LOGO=/chapterone_logo.png

# ===================================
# OPTIONAL - External Services
# ===================================

# Notification Service
# BUILT_IN_FORGE_API_URL=https://api.forge.example.com
# BUILT_IN_FORGE_API_KEY=your_api_key_here

# Analytics
# VITE_ANALYTICS_ENDPOINT=https://analytics.example.com
# VITE_ANALYTICS_WEBSITE_ID=your_website_id
